# Shopify store domain, e.g. "your-store.myshopify.com".
# Defaults to Shopify's public demo catalog (furniture.mock.shop) when unset.
SHOPIFY_STORE_DOMAIN=furniture.mock.shop

# Storefront API public access token (Shopify admin > Apps > Headless / Develop apps).
# Not required for *.mock.shop.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

SHOPIFY_API_VERSION=2025-07

# Customer Account API credentials in the Headless storefront settings.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Must be an HTTPS callback registered in Shopify (localhost/HTTP is not supported).
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=

# Buyer country for prices and availability (@inContext). The language follows the URL (/, /en, /fr, /it).
SHOPIFY_COUNTRY=CH

# Secret used to verify Shopify webhooks (Settings > Notifications > Webhooks)
# that trigger cache revalidation at /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_NAME=Store24
NEXT_PUBLIC_SITE_URL=http://localhost:3000
